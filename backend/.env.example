# === Application ===
APP_NAME=Asset Similarity API
APP_VERSION=0.1.0
DEBUG=true

# === Database ===
# Формат: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://asset_user:asset_password@localhost:5432/asset_db

# === JWT ===
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Storage ===
STORAGE_PATH=data/assets

# === CORS ===
# В формате JSON-массива
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]